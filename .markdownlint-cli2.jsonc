    {
      "filter": ["AGENTS.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Repository Instructions",
            "## Tech Stack",
            "*",
            "## Repository Structure",
            "*",
            "## Setup and Commands",
            "*",
            "## Code Style",
            "*",
            "## Testing",
            "*",
            "## Commits and PRs",
            "*",
            "## Domain Knowledge"
          ]
        }
      }
    },
    {
      "filter": ["README.md", "!*/README.md", "!**/README.md"],
      "combine": "merge",
      "config": {
    // The logo, badges and title block are HTML; the heading they carry is an <h1>
        "MD033": {"allowed_elements": ["a", "br", "div", "h1", "img", "p", "picture", "source"]},
        "MD041": {"allow_preamble": true},
        "MD043": {
          "match_case": true,
          "headings": [
            "# umatare5/common",
            "## Directories",
            "*",
            "## Repositories",
            "*",
            "## Acknowledgement",
            "*",
            "## License"
          ]
        }
      }
    },
    {
      "filter": ["configs/README.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Configuration Files",
            "## Usage",
            "*",
            "## Available configurations"
          ]
        }
      }
    },
    {
      "filter": ["examples/README.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Examples",
            "## Available examples"
          ]
        }
      }
    },
    {
      "filter": ["examples/go-server/README.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Go Server Example",
            "## Features",
            "*",
            "## Usage",
            "*",
            "## Endpoints",
            "*",
            "## Example Requests"
          ]
        }
      }
    },
    {
      "filter": ["renovate/README.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Renovate Configuration Files",
            "## Usage",
            "*",
            "## Available configurations",
            "*",
            "## Update policy",
            "*",
            "## Validation"
          ]
        }
      }
    }
  ],
  "globs": ["**/*.md"],
  "gitignore": true,
  // A symlink to AGENTS.md, which is linted on its own path
  "ignores": [".claude/CLAUDE.md"]
}
