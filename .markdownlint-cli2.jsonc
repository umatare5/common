{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD003": {"style": "atx"},
    "MD004": {"style": "dash"},
    "MD013": false,
    "MD024": {"siblings_only": true},
    // Two adjacent GitHub alerts need no blank line between them
    "MD028": false,
    "MD029": {"style": "ordered"},
    "MD046": {"style": "fenced"},
    "MD048": {"style": "backtick"},
    "MD050": {"style": "asterisk"},
    "MD054": {"url_inline": false},
    "MD055": {"style": "leading_and_trailing"},
    "MD060": {"style": "aligned", "aligned_delimiter": true}
  },
  "overrides": [
    {
      "filter": [".github/workflows/README.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# GitHub Actions Reusable Workflows",
            "## Usage",
            "*",
            "## Available workflows"
          ]
        }
      }
    },
    {
      "filter": [".github/workflows/docs/actionlint.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# actionlint Reusable Workflow",
            "## Usage",
            "*",
            "## Input parameters",
            "*",
            "## Prerequisites",
            "*",
            "## Advanced usage",
            "*",
            "## Configuration file",
            "*",
            "## Execution mode",
            "*",
            "## Auto-detection features",
            "*",
            "## What actionlint checks",
            "*",
            "## Common issues detected",
            "*",
            "## Example output",
            "*",
            "## Related links"
          ]
        }
      }
    },
    {
      "filter": [".github/workflows/docs/codeql.md"],
      "combine": "merge",
      "config": {
        "MD043": {
